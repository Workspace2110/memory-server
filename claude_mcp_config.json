{
  "_readme": "開啟 Claude Code 設定 → Edit Config，將 mcpServers 區塊合併進去",

  "windows_native": {
    "_note": "路徑使用反斜線，<PROJECT_ROOT> 換成實際路徑（如 D:\\Projects\\tools\\memory-server）",
    "mcpServers": {
      "memory": {
        "command": "uv",
        "args": [
          "--directory",
          "<PROJECT_ROOT>\\mcp-server",
          "run", "python", "main.py"
        ],
        "env": {
          "QDRANT_URL": "http://localhost:6333",
          "MCP_TRANSPORT": "stdio"
        }
      }
    }
  },

  "wsl_or_macos": {
    "_note": "路徑使用正斜線，<PROJECT_ROOT> 換成實際路徑",
    "mcpServers": {
      "memory": {
        "command": "uv",
        "args": [
          "--directory",
          "<PROJECT_ROOT>/mcp-server",
          "run", "python", "main.py"
        ],
        "env": {
          "QDRANT_URL": "http://localhost:6333",
          "MCP_TRANSPORT": "stdio"
        }
      }
    }
  },

  "remote_http": {
    "_note": "Claude Chat / Cowork 遠端連線，需先 docker compose up -d",
    "mcpServers": {
      "memory": {
        "url": "https://<YOUR_HOST>/mcp",
        "headers": {
          "Authorization": "Bearer <YOUR_MCP_API_KEY>"
        }
      }
    }
  }
}
